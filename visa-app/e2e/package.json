{
  "name": "visa-app-e2e",
  "private": true,
  "version": "1.0.0",
  "description": "Pruebas end-to-end (Playwright) del flujo completo del cliente",
  "scripts": {
    "db:up": "docker compose -f docker-compose.e2e.yml up -d --wait",
    "db:down": "docker compose -f docker-compose.e2e.yml down",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "bcryptjs": "^2.4.3",
    "pg": "^8.20.0"
  }
}
