DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=replace_with_database_password
DB_NAME=visa_db
# Replace with a unique random value; required when NODE_ENV=production.
SESSION_SECRET=replace_with_a_unique_random_session_secret
# Límites HTTP por IP. Todos los valores deben ser enteros positivos.
RATE_LIMIT_API_WINDOW_MS=900000
RATE_LIMIT_API_MAX=600
RATE_LIMIT_LOGIN_WINDOW_MS=900000
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_REGISTER_WINDOW_MS=3600000
RATE_LIMIT_REGISTER_MAX=5
RATE_LIMIT_RECOVERY_WINDOW_MS=900000
RATE_LIMIT_RECOVERY_MAX=8
# Días de auditoría conservados en login_attempts (entero entre 1 y 365).
LOGIN_ATTEMPT_RETENTION_DAYS=30
# En NODE_ENV=development, backend/app.js crea cuentas y tramites de prueba; init.sql no hace ese seed.
R2_ACCESS_KEY=your_r2_access_key
R2_SECRET_KEY=your_r2_secret_key
R2_BUCKET=your_r2_bucket
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
# Solo para entornos controlados que tengan un volumen local persistente.
# En producción real se recomienda R2 y mantener este valor en false.
LOCAL_STORAGE_FALLBACK=false
LOCAL_UPLOAD_DIR=./local_uploads
PAYMENT_BANK_NAME=
PAYMENT_ACCOUNT_NAME=
PAYMENT_ACCOUNT_NUMBER=
PAYMENT_ACCOUNT_TYPE=
PAYMENT_BANK_INSTRUCTIONS=Solicita los datos bancarios a tu asesor antes de transferir.

# Email SMTP Configuration
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_SECURE=false
SMTP_USER=replace_with_smtp_user
SMTP_PASS=replace_with_smtp_password
SMTP_FROM=VisaGuide <tu-correo@gmail.com>

# EMAIL_REMINDERS_MODE=disabled deshabilita recordatorios.
# Otros valores no fuerzan dry-run: con un transporte configurado el codigo intenta enviarlos.
EMAIL_REMINDERS_MODE=disabled
